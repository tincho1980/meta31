{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meta31-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Returned by `wrangler hyperdrive create` (see docs/setup.md). Not a secret.
			"id": "b5352ce596b94da99fe8cb7d3eacc705",
		},
	],
	"vars": {
		// Supabase project URL (not a secret): JWKS and JWT issuer.
		"SUPABASE_URL": "https://lrusgoutbemqskxrvfhx.supabase.co",
		// PWA origins allowed by CORS, comma separated.
		"ALLOWED_ORIGINS": "http://localhost:5173,https://meta31.pages.dev",
	},
	// Optional secret, only if the project signs with legacy HS256:
	// wrangler secret put SUPABASE_JWT_SECRET
}