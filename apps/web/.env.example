# Copy to apps/web/.env.local for development. Production values live in the GitHub `production` environment.
# They are public (they end up in the bundle): Supabase project URL and publishable key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Worker URL
VITE_API_URL=http://localhost:8787
