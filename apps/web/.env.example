# Copiar a apps/web/.env.local para desarrollo. En Cloudflare Pages se cargan como variables del build.
# Son públicas (terminan en el bundle): URL del proyecto y clave publishable/anon de Supabase.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL del Worker
VITE_API_URL=http://localhost:8787
