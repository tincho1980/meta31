# Mode for the local API (pnpm dev:local:web). No secrets: committed on purpose.
# Skips Google login (dev only, see src/auth.ts) and talks to the local server on :8787.
VITE_AUTH_MODE=local
VITE_API_URL=http://localhost:8787
# Supabase is not used in this mode; placeholders so the client can be created.
VITE_SUPABASE_URL=http://localhost
VITE_SUPABASE_PUBLISHABLE_KEY=unused
