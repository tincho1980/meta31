# Copiar a packages/db/.env (no se sube al repo).
# Session pooler de Supabase (puerto 5432), con el usuario postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Lista blanca del login: se cargan en person con is_user = true.
SEED_EMAIL_MARTIN=
SEED_EMAIL_ROSALIA=
