{
  "name": "meta31",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @meta31/web dev",
    "dev:worker": "pnpm --filter @meta31/worker dev",
    "dev:local": "pnpm --filter @meta31/worker dev:local",
    "dev:local:web": "pnpm --filter @meta31/web dev:localapi"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
